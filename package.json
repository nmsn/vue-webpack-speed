{
  "name": "vue-webpack-speed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:base": "vue-cli-service build",
    "build:performance": "vue-cli-service build --mode performance",
    "build:size": "vue-cli-service build --mode size",
    "build:dev": "vue-cli-service build --mode development",
    "build:analyze": "vue-cli-service build --mode analyze",
    "build:swc": "vue-cli-service build --mode swc",
    "build:esbuild": "vue-cli-service build --mode esbuild",
    "build:all": "npm run clean && npm run build:base && npm run build:performance && npm run build:size && npm run build:analyze && npm run build:swc && npm run build:esbuild",
    "clean": "rimraf dist-* reports",
    "compare": "node scripts/compare-builds.js",
    "benchmark": "node scripts/benchmark-compilers.js",
    "analyze:base": "ANALYZE=true vue-cli-service build",
    "analyze:performance": "ANALYZE=true vue-cli-service build --mode performance",
    "analyze:size": "ANALYZE=true vue-cli-service build --mode size",
    "analyze:dev": "ANALYZE=true vue-cli-service build --mode development",
    "analyze:swc": "ANALYZE=true vue-cli-service build --mode swc",
    "analyze:esbuild": "ANALYZE=true vue-cli-service build --mode esbuild",
    "speed:base": "SPEED_MEASURE=true vue-cli-service build",
    "speed:performance": "SPEED_MEASURE=true vue-cli-service build --mode performance",
    "speed:size": "SPEED_MEASURE=true vue-cli-service build --mode size",
    "speed:dev": "SPEED_MEASURE=true vue-cli-service build --mode development",
    "speed:swc": "SPEED_MEASURE=true vue-cli-service build --mode swc",
    "speed:esbuild": "SPEED_MEASURE=true vue-cli-service build --mode esbuild",
    "full-analyze:base": "ANALYZE=true SPEED_MEASURE=true vue-cli-service build",
    "full-analyze:performance": "ANALYZE=true SPEED_MEASURE=true vue-cli-service build --mode performance",
    "full-analyze:size": "ANALYZE=true SPEED_MEASURE=true vue-cli-service build --mode size",
    "full-analyze:dev": "ANALYZE=true SPEED_MEASURE=true vue-cli-service build --mode development",
    "full-analyze:swc": "ANALYZE=true SPEED_MEASURE=true vue-cli-service build --mode swc",
    "full-analyze:esbuild": "ANALYZE=true SPEED_MEASURE=true vue-cli-service build --mode esbuild",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "element-ui": "^2.15.14",
    "fabric": "^5.3.0",
    "lodash": "^4.17.21",
    "vue": "^2.6.14",
    "vue-router": "^3.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@swc/core": "^1.13.5",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/cli-shared-utils": "~5.0.0",
    "compression-webpack-plugin": "^10.0.0",
    "esbuild-loader": "^4.3.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "rimraf": "^5.0.5",
    "speed-measure-webpack-plugin": "^1.5.0",
    "swc-loader": "^0.2.6",
    "vue-template-compiler": "^2.7.16",
    "webpack-bundle-analyzer": "^4.9.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {
      "vue/multi-word-component-names": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}